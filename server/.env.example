# Port for the AI Capture API (5001 keeps it clear of the Task Manager API on 5000)
PORT=5001

# MongoDB connection (optional — server falls back to an in-memory store if unreachable)
MONGO_URI=mongodb://127.0.0.1:27017/thoughtflow

# Shared capture token — the extension popup and the website panel must both send it.
# Change this for anything beyond local development.
CAPTURE_TOKEN=tf-local-capture-token
