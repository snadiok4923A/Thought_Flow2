# Port for the AI Capture API (5001 keeps it clear of the Task Manager API on 5000).
# Render/Railway/Fly inject PORT automatically — that is honoured out of the box.
PORT=5001

# MongoDB connection.
# LOCAL:   mongodb://127.0.0.1:27017/thoughtflow  (falls back to in-memory if unreachable)
# HOSTED:  REQUIRED — in-memory storage loses every queued capture on restart.
#          Atlas free tier (M0) works: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/thoughtflow
MONGO_URI=mongodb://127.0.0.1:27017/thoughtflow

# Shared capture token — the extension popup and the website panel must both send it.
# For anything beyond local development, generate a long random one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTURE_TOKEN=tf-local-capture-token

# Comma-separated origins allowed to call the API (CORS).
# Leave unset for local development (all origins allowed).
# Example for the hosted site:
# ALLOWED_ORIGINS=https://snadiok4923a.github.io

# Max POST /api/ai-capture writes per minute per IP (default 30).
# CAPTURE_RATE_LIMIT=30
