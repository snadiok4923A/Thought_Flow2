# ThoughtFlow frontend — hosted capture API (optional).
#
# Copy to .env.local for local hosted testing, or pass at build time:
#   VITE_CAPTURE_API_BASE=https://<your-app>.onrender.com/api VITE_CAPTURE_TOKEN=<token> npm run deploy
# Or use the helper (build + deploy in one go):
#   node scripts/deploy-hosted.mjs --api https://<your-app>.onrender.com/api --token <token>
#
# Leave unset for local development (defaults to http://localhost:5001/api).

VITE_CAPTURE_API_BASE=https://your-app.onrender.com/api
VITE_CAPTURE_TOKEN=tf-local-capture-token
