{
  "manifest_version": 3,
  "name": "ThoughtFlow AI Capture",
  "version": "1.1.7",
  "description": "Captures complete Q+A pairs from ChatGPT, Gemini, Arena and other AI chat sites exactly as visible and sends them directly to your open ThoughtFlow tab to become mind-map nodes (no server needed).",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://arena.ai/*",
    "https://www.arena.ai/*",
    "https://lmarena.ai/*",
    "https://www.lmarena.ai/*",
    "https://chat.lmsys.org/*",
    "https://grok.com/*",
    "https://x.ai/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://www.poe.com/*",
    "https://poe.com/*",
    "https://you.com/*",
    "https://chat.you.com/*",
    "https://duck.ai/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://chat.mistral.ai/*",
    "https://chat.qwen.ai/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://felo.ai/*",
    "https://chat.z.ai/*",
    "https://chat.minimax.io/*",
    "https://snadiok4923a.github.io/Thought_Flow2/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "utils/debug.js",
        "content/capture-core.js",
        "content/selectors-chatgpt.js",
        "content/chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "utils/debug.js",
        "content/capture-core.js",
        "content/selectors-gemini.js",
        "content/gemini.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arena.ai/*",
        "https://www.arena.ai/*",
        "https://lmarena.ai/*",
        "https://www.lmarena.ai/*",
        "https://chat.lmsys.org/*",
        "https://grok.com/*",
        "https://grok.x.ai/*",
        "https://x.ai/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.poe.com/*",
        "https://poe.com/*",
        "https://you.com/*",
        "https://chat.you.com/*",
        "https://duck.ai/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://chat.mistral.ai/*",
        "https://chat.qwen.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://felo.ai/*",
        "https://chat.z.ai/*",
        "https://chat.minimax.io/*"
      ],
      "js": [
        "utils/debug.js",
        "content/capture-core.js",
        "content/selectors-generic.js",
        "content/generic.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://snadiok4923a.github.io/Thought_Flow2/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/thoughtflow-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ThoughtFlow AI Capture"
  }
}
